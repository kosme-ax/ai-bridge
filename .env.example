# 서버(또는 Streamlit secrets)에만 보관. 브라우저/깃에 올리지 마십시오.
# 시연은 가상 기업 샘플만 사용합니다.

# 모델 A — Upstage Solar
SOLAR_API_KEY=
SOLAR_BASE_URL=https://api.upstage.ai/v1
SOLAR_MODEL_ID=solar-pro4

# 모델 B — Google Gemini API (Gemma/Gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_ID=gemini-2.0-flash

# 모델 C — Llama via OpenRouter
LLAMA_API_KEY=
LLAMA_BASE_URL=https://openrouter.ai/api/v1
LLAMA_MODEL_ID=meta-llama/llama-3.3-70b-instruct

# 모델 D — OpenAI GPT
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-4o-mini

# 모델 E — LG EXAONE
EXAONE_API_KEY=
EXAONE_BASE_URL=https://api.exaone.ai/v1
EXAONE_MODEL_ID=k-exaone_v2.5

# 키가 없으면 해당 모델은 로컬 Mock으로 시연됩니다.
DEFAULT_MODEL=Solar
